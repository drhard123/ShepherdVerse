{
  "expo": {
    "name": "ShepherdVerse",
    "slug": "ShepherdVerse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shepherdverse",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shepherdverse.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.shepherdverse.app",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2C5F2E",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "ShepherdVerse"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ShepherdVerse to save verse cards to your gallery.",
          "savePhotosPermission": "Allow ShepherdVerse to save verse cards to your gallery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0118dde8-4385-4ace-b869-75864deca66b"
      }
    }
  }
}